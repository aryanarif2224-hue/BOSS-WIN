// If admin has configured banners in site_home_banners, merge/use them
if ($conn) {
    $q = $conn->query("SELECT title, image_url, link_url, sort FROM site_home_banners WHERE active = 1 ORDER BY sort ASC, id ASC");
    if ($q && $q->num_rows > 0) {
        $dbBanners = [];
        $idCounter = 200;
        while ($r = $q->fetch_assoc()) {
            $link = $r['link_url'] ? preg_replace('/^#/', '', $r['link_url']) : '/activity';
            $dbBanners[] = [
                'bannerTitle' => $r['title'],
                'bannerID' => $idCounter++,
                'bannerUrl' => $r['image_url'],
                'jumpType' => 2,
                'contents' => $link,
                'accessAuthType' => 0,
            ];
        }
        if (!empty($dbBanners)) {
            $activityBanners = $dbBanners;
        }
    }
}

$res = [
    'data' => [
        'list' => $activityBanners,
        'pageNo' => 1,
        'totalPage' => 1,
        'totalCount' => count($activityBanners),
    ],
    'code' => 0,
    'msg' => 'Succeed',
    'msgCode' => 0,
    'traceId' => '',
    'serviceNowTime' => $shnunc,
];

http_response_code(200);
echo json_encode($res, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
