<?php
// GetAllGameList — Shreewin-compatible list served locally, merged with the
// admin-controlled on/off + maintenance flags (site_game_controls keyed by gameCode).
// Base catalogue is the captured Shreewin data; DB overrides hide (visible=0) or
// mark-maintenance (maintain=1) any game the admin toggles.
header('Content-Type: application/json; charset=utf-8');
$origin = isset($_SERVER['HTTP_ORIGIN']) ? $_SERVER['HTTP_ORIGIN'] : '*';
header('Access-Control-Allow-Origin: ' . $origin);
header('Access-Control-Allow-Credentials: true');
header('Access-Control-Allow-Headers: Origin, X-Requested-With, Content-Type, Accept, Authorization, AR-REAL-IP');
header('Access-Control-Allow-Methods: GET, POST, OPTIONS');
if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') { http_response_code(204); exit; }

include __DIR__ . '/../../conn.php';

$f = __DIR__ . '/../../shreewin_data/GetAllGameList.json';
if (!is_file($f)) { http_response_code(500); echo json_encode(['code'=>500,'msg'=>'config missing','msgCode'=>500]); exit; }
$d = json_decode(file_get_contents($f), true);
if (!isset($d['data']) || !is_array($d['data'])) $d = ['data' => []];

$ctrl = [];
if ($conn) {
    $q = $conn->query("SELECT game_code, visible, maintain FROM site_game_controls");
    if ($q) while ($r = $q->fetch_assoc()) $ctrl[$r['game_code']] = $r;
}

// Recursively drop disabled games and set maintenance flags. Operates only on
// arrays whose members look like a game item (have a gameCode + image).
$walk = function (&$node) use (&$walk, $ctrl) {
    if (!is_array($node)) return;
    if (array_keys($node) !== range(0, count($node) - 1)) {   // associative object
        foreach ($node as &$v) $walk($v);
        unset($v);
        return;
    }
    // indexed array — filter game items, recurse into the rest
    $keep = [];
    foreach ($node as $i => $item) {
        if (is_array($item) && isset($item['gameCode']) && (isset($item['imgUrl']) || isset($item['img']))) {
            $gc = (string)$item['gameCode'];
            $ov = isset($ctrl[$gc]) ? $ctrl[$gc] : null;
            if ($ov !== null && (int)$ov['visible'] === 0) continue; // hidden by admin
            if ($ov !== null && (int)$ov['maintain'] === 1) {
                $item['isMaintain']       = 1;
                $item['isGameSaasMaintain'] = 1;
            }
            // preserve nested lists inside popular object etc.
            foreach ($item as $k => $vv) { if (is_array($vv)) $walk($vv); }
            $keep[] = $item;
        } else {
            $walk($item);
            $keep[] = $item;
        }
    }
    $node = $keep;
};

$walk($d['data']);

$d['serviceNowTime'] = date('Y-m-d H:i:s');
$d['code'] = 0; $d['msg'] = 'Succeed'; $d['msgCode'] = 0;
echo json_encode($d, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
