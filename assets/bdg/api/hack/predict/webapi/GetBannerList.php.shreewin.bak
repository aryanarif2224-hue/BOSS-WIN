<?php
// GetBannerList — Shreewin-compatible home banners. Admin-managed banners
// (site_home_banners) take priority; if none are active we fall back to the
// captured Shreewin banner set so the page never looks empty.
header('Content-Type: application/json; charset=utf-8');
$origin = isset($_SERVER['HTTP_ORIGIN']) ? $_SERVER['HTTP_ORIGIN'] : '*';
header('Access-Control-Allow-Origin: ' . $origin);
header('Access-Control-Allow-Credentials: true');
header('Access-Control-Allow-Headers: Origin, X-Requested-With, Content-Type, Accept, Authorization, AR-REAL-IP');
header('Access-Control-Allow-Methods: GET, POST, OPTIONS');
if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') { http_response_code(204); exit; }

include __DIR__ . '/../../conn.php';

$rows = [];
if ($conn) {
    $q = $conn->query("SELECT title,image_url,link_url,sort FROM site_home_banners WHERE active=1 ORDER BY sort ASC, id ASC");
    if ($q) while ($r = $q->fetch_assoc()) {
        $rows[] = [
            'url'            => $r['link_url'] ?: ('/#/activity/ActivityDetail?title=' . urlencode($r['title'])),
            'bannerUrl'      => $r['image_url'],
            'categoryType'   => 0,
            'jumpLinkType'   => 0,
            'vendorCode'     => '',
            'gameCode'       => '',
            'gameNameEn'     => $r['title'],
            'accessAuthType' => 0,
        ];
    }
}
if (count($rows) === 0) {
    // fall back to captured Shreewin banners
    $f = __DIR__ . '/../../shreewin_data/GetBannerList.json';
    if (is_file($f)) {
        $d = json_decode(file_get_contents($f), true);
        $rows = $d['data'] ?? [];
    }
}
$d = ['data' => $rows, 'code' => 0, 'msg' => 'Succeed', 'msgCode' => 0, 'traceId' => '', 'serviceNowTime' => date('Y-m-d H:i:s')];
echo json_encode($d, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
